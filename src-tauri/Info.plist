<!-- Merged into the bundle's Info.plist by the Tauri bundler. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Downloaded attachments get com.apple.quarantine (Gatekeeper checks them like in Safari). -->
	<key>LSFileQuarantineEnabled</key>
	<true/>
	<!-- German UI with English fallback (menus/notifications follow the system language). -->
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
		<string>en</string>
	</array>
</dict>
</plist>
